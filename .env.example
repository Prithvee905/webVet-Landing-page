# Where booking / trial requests are emailed. Copy this file to .env.local and fill it in.
# Gmail: turn on 2-step verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=motivebuilders@gmail.com
SMTP_PASS=
LEAD_TO_EMAIL=motivebuilders@gmail.com
